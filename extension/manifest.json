{
  "manifest_version": 3,
  "name": "Kindling",
  "version": "1.0.0",
  "description": "A gentle, shame-free task starter. Opt-in check-ins, one tiny step at a time.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Kindling" },
  "side_panel": { "default_path": "panel/index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "idle", "notifications"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://127.0.0.1:8765/*"]
}
